APP_NAME=MICRODINE
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database utama: PostgreSQL (sesuai ARCHITECTURE.md)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=microdine
DB_USERNAME=postgres
DB_PASSWORD=

# Fase frontend: session/cache/queue tidak memakai database,
# jadi halaman bisa dibuka walau PostgreSQL belum disiapkan.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Modul G (Real-Time). Biarkan `log` di sandbox/CI tanpa akses internet
# (lihat config/broadcasting.php). Di laptop pengembang: jalankan
# `composer require laravel/reverb` lalu `php artisan reverb:install`
# (atau isi manual sesuai nilai di bawah), ubah ke `reverb`, lalu jalankan
# `php artisan reverb:start` berdampingan dengan `php artisan serve`.
BROADCAST_CONNECTION=log
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# Dibaca Vite (lihat resources/js/echo.js) — isi sama dengan REVERB_* di atas.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Midtrans / Payment Gateway (Sandbox Configuration Placeholder)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

VITE_APP_NAME="${APP_NAME}"
